{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Router",
  "version": "0.2.3",
  "identifier": "local.airouter.desktop",
  "build": { "frontendDist": "../desktop/ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "title": "AI Router", "width": 1152, "height": 860, "minWidth": 840, "minHeight": 680 }],
    "security": { "csp": "default-src 'self'; script-src 'self'; style-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' data:; object-src 'none'; base-uri 'none'" }
  },
  "bundle": { "active": true, "targets": "all", "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"] }
}
